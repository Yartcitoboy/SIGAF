# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# respaldos y herramientas locales que no forman parte de la entrega
/.artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx

# credenciales descargadas y respaldos privados
client_secret*.json
credentials.json
service-account*.json
service_account*.json
*.dump
*.backup
/backups/

# configuracion local de editores y asistentes
/.vscode/
/.idea/
/.claude/
/.codex/
/.agents/
/AGENTS.md
/CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
