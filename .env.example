# Configuración de Conexión a Supabase (Local con Docker o Cloud)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Solo servidor. Nunca utilizar el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# APIs Externas
RESEND_API_KEY=tu_resend_api_key_aqui
RESEND_FROM=SIGAF <alertas@tu-dominio-verificado.cl>
CRON_SECRET=tu_clave_secreta_para_cron_aqui

# Accesos temporales: solo se admiten en desarrollo y desde localhost.
SIGAF_ACCESO_LOCAL=false
# Generar un secreto aleatorio de al menos 32 caracteres para activarlos.
SIGAF_LOCAL_SESSION_SECRET=
