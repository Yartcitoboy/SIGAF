# Configuración de Conexión a Supabase del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Solo cron/correos en el servidor. Usuarios usa la función protegida de Supabase.
# Nunca utilizar el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# APIs Externas
RESEND_API_KEY=tu_resend_api_key_aqui
RESEND_FROM=SIGAF <alertas@tu-dominio-verificado.cl>
CRON_SECRET=tu_clave_secreta_para_cron_aqui
