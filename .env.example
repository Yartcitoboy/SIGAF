# Configuración de Conexión a Supabase del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Usuarios y Alertas usan funciones protegidas en Supabase.
# Conecta el cliente OAuth de Google desde Alertas, como Admin.
# Los secretos de Google y el token del cron se guardan en Supabase Vault.
# No añadir secretos de Google ni claves administrativas al navegador o a Git.
